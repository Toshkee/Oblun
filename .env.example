# Copy to .env.local and fill in. None of these are required to run the site locally.

# --- E-mail (contact form and booking requests) ---
# SMTP mailbox that sends the messages, e.g. the one behind info@oblun.com.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: sender shown to guests and the inbox that receives requests.
MAIL_FROM="Oblun Eco Resort <info@oblun.com>"
MAIL_TO=info@oblun.com

# --- Calendar sync (optional) ---
# iCal export links from Airbnb / Booking.com, comma separated, one variable per unit.
# When set, already booked dates are shown as unavailable on the website.
ICAL_VILLA=
ICAL_LARGE_TENT=
ICAL_MEDIUM_TENT=
ICAL_SMALL_TENT=
ICAL_MIRROR_CABIN=

# --- Analytics (optional) ---
# Google Tag Manager container of the old site was GTM-N8LS9F9H.
NEXT_PUBLIC_GTM_ID=
